# Values for `docker compose up` (local stack only).
#
#   cp .env.example .env     # then fill in every key below
#
# .env is gitignored. docker-compose.yml refuses to start if a required key is
# empty, so a missing value fails loudly instead of falling back to a default.
#
# The deployed API does NOT read this file. Render takes its values from the
# dashboard; the server's own template is server/.env.example.

# Postgres password for the local container.
# Use letters and digits only: it is embedded in a connection URL, so
# characters such as @ : / ? # would break it.
POSTGRES_PASSWORD=

# Generate each of these with:  openssl rand -base64 32
JWT_SECRET=
REFRESH_JWT_SECRET=
SESSION_SECRET=

# Google OAuth client for local sign-in. The server throws at startup if
# either is empty. Redirect URI to register in Google Cloud Console:
#   http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
