# Feynman AI — server environment template
#
# Copy to .env and fill in. Never commit .env; it is gitignored.
# Every key below is read by the server. Keys the code never reads were
# removed — see "Removed" at the bottom for what went and why.
#
# Legend:
#   REQUIRED — the server will not start without it
#   NEEDED   — a feature silently stops working without it
#   OPTIONAL — has a sensible default; leave blank unless tuning


# =========================================================
# CORE                                           (REQUIRED)
# =========================================================

NODE_ENV=development
PORT=8000
# Standalone Kokoro TTS service port (run with: npm run tts:start)
TTS_PORT=8125
LOG_LEVEL=info


# =========================================================
# DATABASE                                       (REQUIRED)
# =========================================================
# Neon pooled connection string.

DATABASE_URL=


# =========================================================
# AUTH SECRETS                                   (REQUIRED)
# =========================================================
# Generate each with: openssl rand -base64 32
# On Render these are generated automatically — leave blank there.

JWT_SECRET=
JWT_EXPIRES_IN=30m

REFRESH_JWT_SECRET=
REFRESH_JWT_EXPIRES_IN=15d

SESSION_SECRET=


# =========================================================
# GOOGLE OAUTH                                   (REQUIRED)
# =========================================================
# WARNING: google.config.ts throws at import if ID or SECRET is empty,
# which crashes the server before it binds a port. Never leave blank.
# The callback URL must match Google Console exactly.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/api/auth/google/callback


# =========================================================
# FRONTEND / CORS                                  (NEEDED)
# =========================================================
# Drives CORS and the Socket.IO origin allowlist.
# localhost:3000, :3001 and :5173 are always allowed.
# Use COOKIE_SAME_SITE=none when frontend and API are on different domains.

FRONTEND_URL=http://localhost:3000
COOKIE_SAME_SITE=lax


# =========================================================
# REDIS                                            (NEEDED)
# =========================================================
# REDIS_URL takes precedence. HOST/PORT/PASSWORD are the local fallback.
# BullMQ needs this; without it the audio and URL-ingest workers fail.

REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=
REDIS_DEFAULT_EXPIRATION=1296000
BULLMQ_PREFIX=FeynmanAI


# =========================================================
# LLM — OPENROUTER                                 (NEEDED)
# =========================================================
# OPENROUTER_API_KEY is canonical. OPEN_ROUTER_APIKEY is only a legacy
# fallback read when the canonical one is unset — set just one.

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

LLM_PROVIDER=openrouter
REALTIME_MODEL=google/gemini-2.5-flash
FINAL_EVALUATION_MODEL=anthropic/claude-sonnet-5.5
HELPER_MODEL=meta-llama/llama-3.3-70b-instruct

# Fallback provider/model, used when the primary call fails  (OPTIONAL)
LLM_MODEL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=


# =========================================================
# EMBEDDINGS                                       (NEEDED)
# =========================================================
# Required for resource search. Routed through OpenRouter, so the provider
# must be "openrouter": that is the only provider that uses
# EMBEDDING_MODEL_ENDPOINT and your OpenRouter key. Setting "openai" sends the
# request to api.openai.com instead and an OpenRouter key will be rejected (401).

EMBEDDING_PROVIDER=openrouter
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_MODEL_ENDPOINT=https://openrouter.ai/api/v1/embeddings
# Only needed if you set EMBEDDING_PROVIDER=openai with a real OpenAI key.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# =========================================================
# KOKORO TEXT TO SPEECH                         (FREE LOCAL DEFAULT)
# =========================================================
# Run the bundled Kokoro worker with: npm run tts:start
TTS_PROVIDER=kokoro
KOKORO_TTS_BASE_URL=http://localhost:8125
# Legacy Qwen provider settings (used only when TTS_PROVIDER=local).
QWEN_TTS_BASE_URL=http://localhost:8001/v1
QWEN_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice
# Optional paid/hosted provider settings. Only used when TTS_PROVIDER=dashscope.
QWEN_DASHSCOPE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_API_KEY=
TTS_ENABLED=true
TTS_MAX_CHARS=600
TTS_TIMEOUT_MS=30000
TTS_MAX_RETRIES=2

EMBEDDING_FALLBACK_PROVIDER=
EMBEDDING_FALLBACK_MODEL=


# =========================================================
# SPEECH TO TEXT                                   (NEEDED)
# =========================================================
# Groq is the only provider implemented. Without this, spoken sessions
# produce no transcript.

STT_PROVIDER=groq
STT_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
WHISPER_API_KEY=


# =========================================================
# VECTOR DATABASE — QDRANT                         (NEEDED)
# =========================================================
# Stores resource embeddings for retrieval during a session.

QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=


# =========================================================
# STORAGE — S3 COMPATIBLE                          (NEEDED)
# =========================================================
# Used for uploaded resources. Works with Supabase Storage's S3 endpoint.
# Set S3_FORCE_PATH_STYLE=true for Supabase and most non-AWS providers.

STORAGE_PROVIDER=s3
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_SESSION_TOKEN=
S3_FORCE_PATH_STYLE=true

UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=25


# =========================================================
# EMAIL                                            (NEEDED)
# =========================================================
# Verification and password-reset mail.
#
# EMAIL_USER is the SMTP username; EMAIL_FROM is the visible sender.
# With Gmail they are the same address, so EMAIL_FROM may be left blank
# and EMAIL_USER is used. With Resend the username is literally "resend",
# so EMAIL_FROM must be set or the From header is invalid.
#
# Gmail:  EMAIL_USER=you@gmail.com          EMAIL_FROM=
# Resend: EMAIL_USER=resend                 EMAIL_FROM=noreply@yourdomain
#         EMAIL_HOST=smtp.resend.com        EMAIL_PORT=465  EMAIL_SECURE=true
#         EMAIL_PASS=<resend api key>
#
# EMAIL_FROM also accepts a display form: "Feynman AI" <noreply@domain>

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
SUPPORT_EMAIL=


# =========================================================
# DOCUMENT PARSER (Python + MarkItDown)
# =========================================================
# Leave blank in Docker — the image sets them. Set locally only.
#   macOS/Linux: .venv-markitdown/bin/python
#   Windows:     .venv-markitdown\Scripts\python.exe

DOC_PARSER_PYTHON_PATH=
DOC_PARSER_SCRIPT_PATH=
DOC_PARSER_TIMEOUT_MS=
DOC_PARSER_MAX_FILE_SIZE_MB=
DOC_PARSER_MAX_OUTPUT_MB=
DOC_PARSER_MAX_RETRIES=
DOC_PARSER_ENABLE_PLUGINS=
DOC_PARSER_LLM_MODEL=


# =========================================================
# SECURITY / RATE LIMITING                        (OPTIONAL)
# =========================================================
# ARCJET_KEY: config/arcjet.ts is currently dead code — nothing imports
# it — so this is unused until that module is wired in.

ARCJET_KEY=

RATE_LIMIT_WINDOW_MS=
RATE_LIMIT_MAX_REQUESTS=
AUTH_RATE_LIMIT_WINDOW_MS=
AUTH_RATE_LIMIT_MAX_REQUESTS=
UPLOAD_RATE_LIMIT_WINDOW_MS=
UPLOAD_RATE_LIMIT_MAX_REQUESTS=

WS_RATE_LIMIT_WINDOW_MS=
WS_RATE_LIMIT_MAX_EVENTS=
WS_AUDIO_RATE_LIMIT_WINDOW_MS=
WS_AUDIO_RATE_LIMIT_MAX_CHUNKS=


# =========================================================
# SESSION BEHAVIOUR                               (OPTIONAL)
# =========================================================

WS_PATH=/ws
SESSION_TIMEOUT_MINUTES=120
MAX_TRANSCRIPT_CHUNKS=500
LLM_ANALYSIS_INTERVAL=30
DOMAIN_ALLOWED_SUBJECTS=


# =========================================================
# AUDIO PIPELINE                                  (OPTIONAL)
# =========================================================
# Keep CONCURRENCY at 1 on small instances (512 MB).

AUDIO_PROCESSING_CONCURRENCY=1
AUDIO_CHUNKS_PER_MINUTE=
AUDIO_PROCESSING_ATTEMPTS=
AUDIO_PROCESSING_BACKOFF_MS=


# =========================================================
# RESOURCE PROCESSING                             (OPTIONAL)
# =========================================================

RESOURCE_CHUNK_TOKENS=
RESOURCE_CHUNK_OVERLAP=
URL_FETCH_TIMEOUT_MS=
URL_MAX_FILE_SIZE_MB=


# =========================================================
# DATA RETENTION                                  (OPTIONAL)
# =========================================================

RETENTION_SWEEP_INTERVAL_MINUTES=
RETENTION_SWEEP_ON_STARTUP=
TRANSCRIPT_RETENTION_DAYS=
ANALYTICS_RETENTION_DAYS=
RESOURCE_RETENTION_DAYS=


# =========================================================
# FEATURE FLAGS                                   (OPTIONAL)
# =========================================================

ENABLE_REALTIME_FEEDBACK=true
ENABLE_FINAL_EVALUATION=true
ENABLE_ANALYTICS=false


# =========================================================
# Removed — declared in env.ts but never read by any code
# =========================================================
# Deleting these changes no behaviour. Re-add only when wired up.
#
#   UPLOADTHING_TOKEN     package removed; storage goes through S3
#   ASSEMBLYAI_API_KEY    only Groq STT is implemented
#   DEEPGRAM_API_KEY      only Groq STT is implemented
#   VECTOR_DB_PROVIDER    Qdrant is hardcoded
#   CHROMA_URL            Chroma is not implemented
#   OCR_PROVIDER          no OCR path exists
#   TESSERACT_LANG        no OCR path exists
#   APP_NAME              never read
#   APP_URL               never read
#   API_URL               never read
#   WS_HEARTBEAT_INTERVAL never read
#   TRANSCRIPT_WINDOW_MINUTES          never read
#   ENABLE_TOPIC_DRIFT_DETECTION       never read
#   ENABLE_AUDIO_PROCESSING_QUEUE      never read; the queue always runs
#   AUDIO_CHUNK_DURATION               never read
#   AUDIO_SILENCE_THRESHOLD            never read
#   AUDIO_MIN_CHUNK_DURATION_MS        never read
#   AUDIO_MAX_CHUNK_BYTES              never read
#   AUDIO_MAX_CHUNK_DURATION_MS        never read
#   AUDIO_PROCESSING_RESULT_TIMEOUT_MS never read
#   EFFECT_NO_VERSION_WARNING          not in the env schema at all
