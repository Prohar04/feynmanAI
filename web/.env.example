# Copy to .env.local and fill in. Never commit .env.local.

# Server-side: where the Next.js server reaches the Feynman AI API.
# Falls back to NEXT_PUBLIC_API_URL when empty.
BACKEND_URL=https://api.feynmanai.tech

# Server-side: encrypts the session cookie. At least 32 random characters.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Browser-side: API origin used for "Continue with Google" and the Socket.IO
# connection. Must match the backend's FRONTEND_URL / CORS configuration.
NEXT_PUBLIC_API_URL=https://api.feynmanai.tech
NEXT_PUBLIC_WS_PATH=/ws
